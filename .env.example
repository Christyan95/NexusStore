# ============================================================
# Nexus Store — Contrato de Variáveis de Ambiente (Frontend)
# Copie para .env.local e preencha os valores reais.
# NUNCA versione arquivos .env ou credenciais service_role.
# ============================================================

# URL pública do projeto Supabase (obrigatória em produção)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anon do Supabase (somente leitura via RLS na role_leitura_nexusstore)
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Opcional: URL base da Edge Function de redirecionamento rastreado
# Ex: https://seu-projeto.supabase.co/functions/v1/redirect
VITE_REDIRECT_BASE_URL=

# Opcional (SOMENTE DEV): ativa fixture local quando Supabase não estiver configurado
# Ignorado automaticamente em builds de produção (import.meta.env.DEV === false)
VITE_USE_DEV_FIXTURE=false

# ============================================================
# Variáveis de Ambiente — Supabase Edge Functions (Server-Side)
# Configurar via `supabase secrets set ...` (NUNCA prefixar com VITE_)
# ============================================================
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=chave-privada-service-role
# CLICK_IP_HASH_SALT=segredo-aleatorio-minimo-32-caracteres
# ALLOWED_ORIGINS=https://nexusstore.com.br,http://localhost:5173
